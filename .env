# Shared defaults for every mode. Mode files (.env.<mode>) override these.
VITE_CONSENT_DEFAULT=denied
VITE_DEBUG=false
VITE_FS_CAPTURE=false
VITE_FS_DEV_MODE=false
# FullStory Org ID (Settings > Data Capture and Privacy > Fullstory Setup), e.g. o-XXXXXX-na1.
# Empty = FullStory never loads. Set it per environment below, or at deploy time in app-config.js.
VITE_FS_ORG_ID=

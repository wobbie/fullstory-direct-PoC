{
  "name": "fullstory-direct-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:test": "tsc --noEmit && vite build --mode test",
    "build:uat": "tsc --noEmit && vite build --mode uat",
    "build:preprod": "tsc --noEmit && vite build --mode preprod",
    "build:prod": "tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fullstory/browser": "2.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.8",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
